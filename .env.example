# oneday-dental-global — 환경변수 템플릿. 이 파일을 .env.local 로 복사해 값을 채우세요.

# Public site URL (canonical / hreflang / sitemap / OG base)
NEXT_PUBLIC_SITE_URL=https://global.oneday-dental.co.kr

# Analytics — 채우면 활성 (비면 스크립트 미로딩)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Messenger (대만 1순위 = LINE)
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# Lead webhook (CRM/Slack) — server-only. ★ afformationcrm 적재 연결 지점
CONSULT_WEBHOOK_URL=

# 전역 하단 블록(모든 페이지, Footer 바로 위) — 구글맵 실제 리뷰 라이브 연동. server-only.
# Google Cloud Console에서 "Places API (New)" 활성화 + API 키 발급 필요(과금 API).
# 키 발급 후 database/clinic.json의 branches[].placeId(1~3관)도 채워야 노출된다.
GOOGLE_PLACES_API_KEY=

# ── 빌드 파이프라인 전용 (server-only · 절대 커밋 금지) ──
SCRAPE_SOURCE_URL=          # 원데이치과 한국 공식 홈페이지 (Apify 스크래핑 대상)
BENCHMARK_URL=              # 대만 치과 벤치마크 URL (design-benchmark 대상)
APIFY_TOKEN=               # Apify 토큰
GEMINI_API_KEY=            # Gemini 키 (나노바나나 이미지 생성)
